{
  "name": "excel-to-web",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "setup": "./scripts/setup.sh",
    "start": "./scripts/start.sh",
    "stop": "./scripts/stop.sh",
    "status": "./scripts/status.sh",
    "start:server": "cd server && node src/server.js",
    "start:client": "cd client && npm run dev",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "docs:screenshots": "playwright test e2e/capture-quickstart-screenshots.spec.js -c playwright.screenshots.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  }
}
